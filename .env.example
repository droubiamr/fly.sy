# Copy to .env.local. Both are safe to expose to the browser; RLS does the protecting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Google Search Console → Add property → "HTML tag" method → copy the content="…" value.
# (public/google19d367ed05691ede.html already serves the HTML-file method.)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server only, never NEXT_PUBLIC_. Supabase → Project Settings → API → service_role. Bypasses RLS: it is how
# /api/track records page views and how /admin reads analytics and moderates reports. On Cloudflare:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin, 12 characters or more. The admin area stays switched off while this is empty.
# Changing it signs every session out. On Cloudflare: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=
