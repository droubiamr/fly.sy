# Copy to .env.local for `npm run dev`, or to .dev.vars for `npm run preview` (wrangler). Never commit either.
# The database is the D1 binding in wrangler.jsonc, not a variable: nothing to set here for it.

# Optional. Google Search Console → Add property → "HTML tag" method → copy the content="…" value.
# (public/google19d367ed05691ede.html already serves the HTML-file method.)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ——— Admin sign-in (/admin). All four are required; the form stays off until they are set. ———
# Generate the first two with `npm run admin:setup`. In production set each with `npx wrangler secret put NAME`,
# or in the dashboard: Workers & Pages → fly-sy → Settings → Variables and Secrets → Add → type Secret.
# No terminal? Set ADMIN_PASSWORD (the password itself, 12+ characters) instead of ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
# Cloudflare dashboard → Turnstile → Add widget (hostname fly.sy). For local development use Cloudflare's
# testing pair, which always passes: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Strongly recommended. Cloudflare Zero Trust → Access → Applications → self-hosted app on fly.sy/admin*.
# Team domain like https://yourteam.cloudflareaccess.com; AUD tag from the application's settings.
# When set, every admin request must carry a valid Access token as well as the session.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
