{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Worker names allow letters, digits and hyphens only, so not "fly.sy".
  "name": "fly-sy",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Reports, page views and admin sessions. Create it once with `npx wrangler d1 create fly-sy` and paste the
  // id it prints here; then `npx wrangler d1 migrations apply fly-sy --remote`. Local dev needs no id change.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fly-sy",
      "database_id": "1ade1e7c-0c2c-476a-8d4e-071a02b0a5c9",
      "migrations_dir": "migrations"
    }
  ],
  // Coarse per-IP throttle on admin sign-in: 5 tries a minute per Cloudflare location. The durable lockout
  // lives in D1 (login_attempts); this only sheds load before any work is done.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Preview builds (every branch other than main, via `wrangler preview`) must name their own bindings.
  // They share the production database, so a preview's visits and reports land in the real tables; point
  // database_id at a separate D1 database if that ever matters. The rate limiter gets its own namespace.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "1ade1e7c-0c2c-476a-8d4e-071a02b0a5c9"
      }
    ],
    "ratelimits": [
      {
        "name": "LOGIN_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
