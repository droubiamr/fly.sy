{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Worker names allow letters, digits and hyphens only, so not "fly.sy".
  "name": "fly-sy",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Reports, page views and admin sessions. Create it once with `npx wrangler d1 create fly-sy` and paste the
  // id it prints here; then `npx wrangler d1 migrations apply fly-sy --remote`. Local dev needs no id change.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fly-sy",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Coarse per-IP throttle on admin sign-in: 5 tries a minute per Cloudflare location. The durable lockout
  // lives in D1 (login_attempts); this only sheds load before any work is done.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
